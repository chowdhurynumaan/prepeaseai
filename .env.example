# Firebase Configuration
# Copy this file to .env.local and fill in your values

# Firebase API Key (get from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Project Configuration
# These are fixed for apps-e1163 project:
VITE_FIREBASE_PROJECT_ID=apps-e1163
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Gemini API (Optional - users can provide via UI)
VITE_GEMINI_API_KEY=your_gemini_api_key_optional
